# Application
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_be?schema=public

# Redis (optional for development)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-16-chars-change-in-production
SESSION_COOKIE_NAME=sid
SESSION_DAYS=7
BCRYPT_ROUNDS=12

# Super Admin Bootstrap (optional - for initial setup)
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=changeme123
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=Super
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Admin

# Stripe (optional - for payments)
STRIPE_SECRET_KEY=
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_REDIRECT_URI=http://localhost:3000/settings/payments/stripe/callback

# PayPal (optional - for payments)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_REDIRECT_URI=http://localhost:3000/settings/payments/paypal/callback

# Payment Token Encryption (required in production)
PAYMENT_TOKEN_ENCRYPTION_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=invoices@yourdomain.com
EMAIL_FROM_NAME=Invoice App
EMAIL_REPLY_TO=support@yourdomain.com

# Cloudflare R2 Storage (optional - for logos, PDFs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Worker
WORKER_CONCURRENCY=2