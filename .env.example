# INVOICE-BE Environment Configuration
# Copy to .env for local dev. For Railway: set in Dashboard > Variables.
# Each variable explains why it exists, not what it does.

# Application
# Framework behavior (logging, errors, caching). Must be "production" in deployed envs.
NODE_ENV=development

# Railway assigns automatically. App binds to 0.0.0.0:PORT for external traffic.
PORT=4000

# Only these origins may send credentials. Prevents CSRF and data leakage.
# Production: exact frontend domain, no wildcards.
CORS_ORIGIN=http://localhost:3000

# Public backend URL for webhooks, emails, redirects. Must match Railway domain.
API_URL=http://localhost:4000

# Public frontend URL for email links and OAuth callbacks.
APP_URL=http://localhost:3000

# Database (PostgreSQL)
# Primary data store. Migrations run automatically on deploy.
# LOCAL: postgresql://postgres:postgres@localhost:5432/invoice_be?schema=public
# RAILWAY: Injected by PostgreSQL plugin.
DATABASE_URL=

# Redis
# Rate limiting, job queues (BullMQ), session caching.
# Without it, rate limits fall back to in-memory (not shared across replicas).
# LOCAL: redis://localhost:6379
# RAILWAY: Injected by Redis plugin.
REDIS_URL=

# Authentication
# Signs JWT tokens and session cookies. 32+ random chars. Rotate annually.
# Generate: openssl rand -base64 32
JWT_SECRET=

# Generic cookie name reduces fingerprinting.
SESSION_COOKIE_NAME=sid

# Session lifetime. Balances security vs UX.
SESSION_DAYS=7

# Bcrypt cost factor. 12 is 2024 baseline; increase as hardware improves.
BCRYPT_ROUNDS=12

# Super Admin Bootstrap (optional - runs once if no users exist)
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=Super
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Admin

# Stripe (optional - payments)
# Server-side secret. Never expose client-side. Restrict via Dashboard permissions.
STRIPE_SECRET_KEY=

# OAuth client ID for Stripe Connect onboarding.
STRIPE_CLIENT_ID=

# OAuth client secret for Stripe Connect.
STRIPE_CLIENT_SECRET=

# Verifies webhook signatures. Prevents spoofed payment events.
STRIPE_WEBHOOK_SECRET=

# Redirect after Connect onboarding. Must match Stripe Dashboard registration.
STRIPE_REDIRECT_URI=

# PayPal (optional - payments)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Must match credentials (sandbox creds only work in sandbox).
PAYPAL_ENV=sandbox

# Verifies webhook signatures.
PAYPAL_WEBHOOK_ID=

# Redirect after Connect onboarding. Must match PayPal App settings.
PAYPAL_REDIRECT_URI=

# Payment Token Encryption (REQUIRED IN PRODUCTION)
# Encrypts stored payment method tokens. Without it, tokens stored in plaintext.
# Exactly 32 bytes base64. Generate: openssl rand -base64 32
# Loss = inability to decrypt existing payment tokens.
PAYMENT_TOKEN_ENCRYPTION_KEY=

# Email (Resend)
# Domain must be verified in Resend Dashboard.
RESEND_API_KEY=

# From address. Must use verified domain or emails bounce/spam.
EMAIL_FROM=invoices@yourdomain.com

# Display name in inbox. Recognizable name improves open rates.
EMAIL_FROM_NAME=Invoice App

# Reply-to routes responses to support inbox.
EMAIL_REPLY_TO=support@yourdomain.com

# Cloudflare R2 Storage (optional - logos, PDFs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Worker
# Concurrent job processors for email queue. Higher = faster but more Redis connections.
WORKER_CONCURRENCY=2