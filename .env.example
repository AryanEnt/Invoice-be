NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://outinvoice:outinvoice@localhost:5432/outinvoice?schema=public
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated browser origins allowed to call the API with cookies
CORS_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=sid
SESSION_DAYS=7
BCRYPT_ROUNDS=12

# Used by `npm run prisma:seed` (be/prisma/seed.ts). Not an HTTP endpoint.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=Super
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Admin

# Payment integrations (server only — never expose secrets to the frontend)

# Stripe Connect (Standard OAuth — one platform Stripe account)
# Dashboard: https://dashboard.stripe.com/settings/connect
STRIPE_CLIENT_ID=ca_...
# Optional; defaults to STRIPE_SECRET_KEY for OAuth token exchange
STRIPE_CLIENT_SECRET=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Must exactly match Connect → Settings → Redirects
# Example (ngrok): https://YOUR_SUBDOMAIN.ngrok-free.dev/api/stripe/oauth/callback
STRIPE_REDIRECT_URI=

# PayPal
# App credentials from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live (alias: PAYPAL_ENV). Must match the Dashboard toggle and Client ID/Secret pair.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
# Authoritative Log in with PayPal Return URL (required for Connect).
# Must EXACTLY match Developer Dashboard → app → Log in with PayPal → Advanced Settings → Return URL
#
# Local (FE callback):
# PAYPAL_REDIRECT_URI=http://localhost:3000/settings/payment/paypal/callback
# API_URL=http://localhost:4000
#
# Via ngrok (tunnel API port 4000). Keep API_URL on the same https host so auth cookies use SameSite=None.
# PAYPAL_REDIRECT_URI=https://YOUR_SUBDOMAIN.ngrok-free.dev/api/settings/payment/paypal/callback
# API_URL=https://YOUR_SUBDOMAIN.ngrok-free.dev
# FE: NEXT_PUBLIC_API_URL must match API_URL (set in fe/.env.local — it overrides fe/.env)
PAYPAL_REDIRECT_URI=http://localhost:3000/settings/payment/paypal/callback
API_URL=http://localhost:4000
# Required in production (32+ chars). Encrypts PayPal Connect tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_TOKEN_ENCRYPTION_KEY=

# Production tip: put Cloudflare (orange cloud) in front of FE and API.
# Rate limiting uses CF-Connecting-IP when present. Keep CORS_ORIGIN to real FE HTTPS origins only.

# Resend HTTPS API — server only; never expose RESEND_API_KEY to the frontend.
# Domain must be verified in Resend (e.g. send.entegrasources.com).
RESEND_API_KEY=
# Full From header recommended:
# EMAIL_FROM=Invoice <invoice@send.entegrasources.com>
EMAIL_FROM=
EMAIL_FROM_NAME=Invoice
# Optional reply mailbox (e.g. company inbox). Not used for sending.
EMAIL_REPLY_TO=
APP_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible). Keep private — never expose to the frontend.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
