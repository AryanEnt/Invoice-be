# =============================================================================
# INVOICE-BE Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# For Railway: Set these in Railway Dashboard > Variables (don't commit .env)
# =============================================================================

# -----------------------------------------------------------------------------
# Application (Railway sets PORT automatically)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# LOCAL: postgresql://postgres:postgres@localhost:5432/invoice_be?schema=public
# RAILWAY: Provided automatically when you add PostgreSQL plugin
#          Format: postgresql://user:pass@host:port/db?schema=public
DATABASE_URL=

# -----------------------------------------------------------------------------
# Redis (for rate limiting, queues, caching)
# -----------------------------------------------------------------------------
# LOCAL: redis://localhost:6379
# RAILWAY: Provided automatically when you add Redis plugin
#          Format: redis://user:pass@host:port or rediss:// for TLS
REDIS_URL=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# RAILWAY: Set in Railway Dashboard > Variables
JWT_SECRET=
SESSION_COOKIE_NAME=sid
SESSION_DAYS=7
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Super Admin Bootstrap (optional - runs on first deploy)
# -----------------------------------------------------------------------------
# RAILWAY: Set in Railway Dashboard > Variables
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=Super
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Admin

# -----------------------------------------------------------------------------
# Stripe (optional - for payments)
# -----------------------------------------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
STRIPE_WEBHOOK_SECRET=
# RAILWAY: Use your Railway domain: https://your-app.up.railway.app/settings/payments/stripe/callback
STRIPE_REDIRECT_URI=

# -----------------------------------------------------------------------------
# PayPal (optional - for payments)
# -----------------------------------------------------------------------------
# Get from: https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
# RAILWAY: Use your Railway domain: https://your-app.up.railway.app/settings/payments/paypal/callback
PAYPAL_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Payment Token Encryption (REQUIRED IN PRODUCTION)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# RAILWAY: MUST SET in Railway Dashboard > Variables for production
PAYMENT_TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Get from: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=invoices@yourdomain.com
EMAIL_FROM_NAME=Invoice App
EMAIL_REPLY_TO=support@yourdomain.com

# -----------------------------------------------------------------------------
# Cloudflare R2 Storage (optional - for logos, PDFs)
# -----------------------------------------------------------------------------
# Get from: https://dash.cloudflare.com/?to=/:account/r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=2

# =============================================================================
# RAILWAY-SPECIFIC NOTES
# =============================================================================
# 1. Railway automatically provides: PORT, DATABASE_URL, REDIS_URL
# 2. Set all secrets in Railway Dashboard > Variables (not in this file)
# 3. For custom domain: Add in Railway Dashboard > Settings > Domains
# 4. Health check: GET /health (configured in railway.toml)
# 5. Logs: View in Railway Dashboard > Deployments > [deployment] > Logs
# 6. Scale: Railway Dashboard > Settings > Replicas
# =============================================================================